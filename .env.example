# Copy to .env and adjust. Demo values only, never use in production.
POSTGRES_USER=barely
POSTGRES_PASSWORD=barely
POSTGRES_DB=barely

# Used by the app container (host "db" is the Compose service name)
DATABASE_URL=postgresql+psycopg://barely:barely@db:5432/barely

# Session cookie signing key. Generate a long random string for anything beyond the demo.
SECRET_KEY=change-me-demo-secret

APP_ENV=development

# Reverse proxy: which client IPs may set X-Forwarded-* headers. "*" trusts every proxy, fine
# when only the proxy can reach the container. Use the proxy's IP or Docker network otherwise.
FORWARDED_ALLOW_IPS=*

# Set to true when the app is served over HTTPS (behind a TLS-terminating proxy): the session
# cookie then gets the Secure flag. Leave false for plain http://localhost development.
SECURE_COOKIES=false
