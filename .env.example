# Copy to .env and adjust. Demo values only, never use in production.
POSTGRES_USER=barely
POSTGRES_PASSWORD=barely
POSTGRES_DB=barely

# Used by the app container (host "db" is the Compose service name)
DATABASE_URL=postgresql+psycopg://barely:barely@db:5432/barely

# Session cookie signing key. Generate a long random string for anything beyond the demo.
SECRET_KEY=change-me-demo-secret

APP_ENV=development
